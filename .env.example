# Copy to .env and adjust. .env is git-ignored; never commit secrets.
APP_ENV=development
LOG_LEVEL=debug
HTTP_ADDR=:8080

DATABASE_URL=postgres://postgres:postgres@localhost:5432/tasks?sslmode=disable
DB_MAX_CONNS=10

# Used only by `make test-integration`
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/tasks_test?sslmode=disable
